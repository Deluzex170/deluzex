{
  "name": "deluzex",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"next,fastapi\" -c \"cyan,magenta\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "next dev",
    "dev:backend": "python -m uvicorn main:app --app-dir backend --reload --host 0.0.0.0 --port 8000",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "install:backend": "python -m pip install -r backend/requirements.txt",
    "install:all": "npm install && npm run install:backend"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@reduxjs/toolkit": "^2.12.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.11.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.45.0",
    "mongodb": "^7.7.0",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-redux": "^9.3.0",
    "redux-persist": "^6.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/whatwg-url": "^13.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
